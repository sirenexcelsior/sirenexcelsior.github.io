---
layout: default
---
<div class="post" data-blog-languages data-selected-language="{{ page.content_lang }}" data-interface-language="{{ page.lang }}" data-language-base="{{ page.blog_language_base | relative_url }}"{% if page.blog_language_entry %} data-language-entry{% endif %}>
  <div class="header-bar">
    <h1>{{ site.blog_name }}</h1>
    <h2>{% if page.lang == 'ru' %}Делюсь своими знаниями и опытом{% else %}{{ site.blog_description }}{% endif %}</h2>
  </div>

  <nav class="blog-language-filter" aria-label="{% if page.lang == 'ru' %}Язык статей{% else %}Article language{% endif %}">
    <span>{% if page.lang == 'ru' %}Язык статей:{% else %}Article language:{% endif %}</span>
    {% assign content_languages = 'en,ru,zh' | split: ',' %}
    {% for language in content_languages %}
      {% assign language_url = page.blog_language_base | append: language | append: '/' %}
      <a class="blog-language-option"
         href="{{ language_url | relative_url }}" data-blog-language="{{ language }}" lang="{{ language }}"
         {% if page.content_lang == language %}aria-current="page"{% endif %}>
        {% if language == 'zh' %}CH{% else %}{{ language | upcase }}{% endif %} ({{ page.blog_language_counts[language] }})
      </a>
    {% endfor %}
  </nav>

  {% if page.language_featured_posts.size > 0 %}
    <div class="container featured-posts px-0">
      <div class="row">
        {% for post in page.language_featured_posts %}
          {% assign post_link = post.redirect | default: post.url %}
          <div class="card-item col-md-6 mb-3" data-content-language="{{ post.content_lang }}">
            <a href="{{ post_link | relative_url }}"{% if post.external_source %} target="_blank" rel="noopener noreferrer"{% endif %}>
              <div class="card hoverable h-100">
                <div class="card-body" lang="{{ post.content_lang }}">
                  <i class="fa-solid fa-thumbtack fa-xs float-right" aria-hidden="true"></i>
                  <h3 class="card-title">{{ post.title }}</h3>
                  <p class="card-text">{{ post.description }}</p>
                </div>
              </div>
            </a>
          </div>
        {% endfor %}
      </div>
    </div>
    <hr>
  {% endif %}

  <ul class="post-list">
    {% for post in page.language_posts %}
      {% assign post_link = post.redirect | default: post.url %}
      {% assign post_text = post.feed_content | default: post.content %}
      {% assign read_time = post_text | strip_html | number_of_words | divided_by: 180 | plus: 1 %}
      <li data-content-language="{{ post.content_lang }}">
        {% if post.thumbnail %}<div class="row"><div class="col-sm-9">{% endif %}
        <h3 lang="{{ post.content_lang }}">
          <a class="post-title" href="{{ post_link | relative_url }}"{% if post.external_source %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ post.title }}</a>
        </h3>
        <p lang="{{ post.content_lang }}">{{ post.description }}</p>
        <p class="post-meta">
          {{ read_time }} {% if page.lang == 'ru' %}мин. чтения{% else %}min read{% endif %} &nbsp; &middot; &nbsp;
          {% if page.lang == 'ru' %}{{ post.date | date: '%d.%m.%Y' }}{% else %}{{ post.date | date: '%B %d, %Y' }}{% endif %}
          {% if post.external_source %}&nbsp; &middot; &nbsp; {{ post.external_source }}{% endif %}
        </p>
        <p class="post-tags">
          <i class="fa-solid fa-calendar fa-sm" aria-hidden="true"></i> {{ post.date | date: '%Y' }}
          {% for tag in post.tags %}&nbsp; &middot; &nbsp; #{{ tag }}{% endfor %}
          {% for category in post.categories %}&nbsp; &middot; &nbsp; {{ category }}{% endfor %}
        </p>
        {% if post.thumbnail %}
            </div>
            <div class="col-sm-3"><img class="card-img" src="{{ post.thumbnail | relative_url }}" alt="" loading="lazy"></div>
          </div>
        {% endif %}
      </li>
    {% else %}
      <li>{% if page.lang == 'ru' %}На этом языке пока нет статей.{% else %}No articles in this language yet.{% endif %}</li>
    {% endfor %}
  </ul>

  {% if page.blog_pagination.total_pages > 1 %}
    <nav aria-label="{% if page.lang == 'ru' %}Страницы блога{% else %}Blog pages{% endif %}">
      <ul class="pagination justify-content-center flex-wrap">
        {% if page.blog_pagination.previous %}
          <li class="page-item"><a class="page-link" rel="prev" href="{{ page.blog_pagination.previous | relative_url }}">{% if page.lang == 'ru' %}Назад{% else %}Previous{% endif %}</a></li>
        {% endif %}
        {% for item in page.blog_pagination.pages %}
          <li class="page-item {% if item.number == page.blog_pagination.page %}active{% endif %}">
            <a class="page-link" href="{{ item.url | relative_url }}"{% if item.number == page.blog_pagination.page %} aria-current="page"{% endif %}>{{ item.number }}</a>
          </li>
        {% endfor %}
        {% if page.blog_pagination.next %}
          <li class="page-item"><a class="page-link" rel="next" href="{{ page.blog_pagination.next | relative_url }}">{% if page.lang == 'ru' %}Далее{% else %}Next{% endif %}</a></li>
        {% endif %}
      </ul>
    </nav>
  {% endif %}
</div>
