{% assign language = page.lang | default: 'en' %}
{% assign labels = site.data.i18n[language] %}
{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      &copy; {{ labels.copyright }} {{ site.time | date: '%Y' }}
      {{ labels.name }}. {{ labels.powered_by }}
      {% if site.impressum_path %}
        <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
      {% endif %}
      {% if site.last_updated %}
        {{ labels.last_updated }} {{ 'now' | date: '%B %d, %Y' }}.
      {% endif %}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    <div class="container">
      &copy; {{ labels.copyright }} {{ site.time | date: '%Y' }}
      {{ labels.name }}. {{ labels.powered_by }}
      {% if site.impressum_path %}
        <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
      {% endif %}
      {% if site.last_updated %}
        {{ labels.last_updated }} {{ 'now' | date: '%B %d, %Y' }}.
      {% endif %}
    </div>
  </footer>
{% endif %}
