{% assign language = page.lang | default: 'en' %}
{% assign labels = site.data.i18n[language] %}
{% assign home_url = labels.home %}
<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-xl {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if page.permalink != home_url %}
        <a class="navbar-brand title font-weight-lighter" href="{{ home_url | relative_url }}">
          {% if language == 'ru' %}
            {{ labels.name }}
          {% elsif site.title == 'blank' %}
            {% if site.first_name %}
              <span class="font-weight-bold">
                {{- site.first_name -}}
              </span>
            {% endif %}
            {% if site.middle_name %}
              {{- site.middle_name -}}
            {% endif %}
            {% if site.last_name %}
              {{- site.last_name -}}
            {% endif %}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
      {% elsif site.enable_navbar_social %}
        <!-- Social Icons -->
        <div class="navbar-brand social">{% include social.liquid %}</div>
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="{{ labels.toggle_navigation }}"
      >
        <span class="sr-only">{{ labels.toggle_navigation }}</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          <!-- About -->
          <li class="nav-item {% if page.permalink == home_url %}active{% endif %}">
            <a class="nav-link" href="{{ home_url | relative_url }}">
              {{- labels.navigation.about }}
              {% if page.permalink == home_url %}
                <span class="sr-only">{{ labels.current }}</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null and p.lang != 'ru' %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-toggle="dropdown"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- labels.navigation[p.title] | default: p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">{{ labels.current }}</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a class="dropdown-item {% if page.title == child.title %}active{% endif %}" href="{% if language == 'ru' %}{{ child.permalink | prepend: '/ru' | relative_url }}{% else %}{{ child.permalink | relative_url }}{% endif %}">
                          {{- labels.navigation[child.title] | default: child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                <li class="nav-item {% if page.translation_url == p.permalink or page.permalink == p.permalink %}active{% endif %}">
                  {% assign url = p.permalink | default: p.url %}
                  {% if language == 'ru' %}{% assign url = url | prepend: '/ru' %}{% endif %}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    {{- labels.navigation[p.title] | default: p.title }}
                    {% if page.translation_url == p.permalink or page.permalink == p.permalink %}
                      <span class="sr-only">{{ labels.current }}</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" title="{{ labels.change_theme }}">
                <i class="ti ti-sun-moon" id="light-toggle-system"></i>
                <i class="ti ti-moon-filled" id="light-toggle-dark"></i>
                <i class="ti ti-sun-filled" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
          {% assign translation_url = page.translation_url | default: '/ru/blog/' %}
          {% if paginator.page > 1 %}
            {% if language == 'ru' %}{% assign translation_url = page.url | remove_first: '/ru' %}{% else %}{% assign translation_url = page.url | prepend: '/ru' %}{% endif %}
          {% endif %}
          <li class="nav-item">
            <a id="language-toggle" class="nav-link" href="{{ translation_url | relative_url }}" hreflang="{% if language == 'ru' %}en{% else %}ru{% endif %}" lang="{% if language == 'ru' %}en{% else %}ru{% endif %}" aria-label="{{ labels.switch_language }}">
              {% if language == 'ru' %}EN{% else %}RU{% endif %}
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
